{
  "compilerOptions": {
    "esModuleInterop": true,

    "skipLibCheck": true,
    "target": "es2022",

    "resolveJsonModule": true,
    "moduleDetection": "force",
    "strict": true,
    "module": "commonjs",

    "outDir": "dist",
    "sourceMap": true,
    "lib": ["es2022"]
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
